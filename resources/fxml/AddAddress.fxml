<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddAddressController">
    <Label text="Add Address" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="10"><Label text="Qyteti:" GridPane.rowIndex="0" GridPane.columnIndex="0"/><TextField fx:id="cityField" GridPane.rowIndex="0" GridPane.columnIndex="1"/><Label text="Rruga:" GridPane.rowIndex="1" GridPane.columnIndex="0"/><TextField fx:id="streetField" GridPane.rowIndex="1" GridPane.columnIndex="1"/><Label text="Numri:" GridPane.rowIndex="2" GridPane.columnIndex="0"/><TextField fx:id="numberField" GridPane.rowIndex="2" GridPane.columnIndex="1"/><Label text="Kodi:" GridPane.rowIndex="3" GridPane.columnIndex="0"/><TextField fx:id="postalCodeField" GridPane.rowIndex="3" GridPane.columnIndex="1"/></GridPane>
    <HBox spacing="10"><Button text="Shto" onAction="#handleSave"/><Button text="Anulo" onAction="#handleCancel"/></HBox>
</VBox>
